document.addEventListener('input', (e)=>{
  let a=e.target; if(!(a.tagName==='INPUT')) return;
  if(!(a.type==='email' || (a.id||'').toLowerCase().includes('email'))) return;
  let v=a.value.toLowerCase();
  if(v.includes(' at ') || v.includes(' dot ') || v.includes(' ')){
    let fixed=v.replace(/\s+at\s+/g,'@').replace(/\bat\b/g,'@').replace(/\s+dot\s+/g,'.').replace(/\bdot\b/g,'.').replace(/\s*@\s*/g,'@').replace(/\s*\.\s*/g,'.').replace(/\s+/g,'');
    if(fixed!==v && fixed.includes('@')){ a.value=fixed; }
  }
});
(function(){
  let SR=window.SpeechRecognition||window.webkitSpeechRecognition; if(!SR) return;
  let Orig=SR;
  function Wrapped(){ let inst=new Orig(); let origAdd=inst.addEventListener.bind(inst);
    inst.addEventListener=function(type,cb){
      if(type==='result') return origAdd(type, function(ev){
        try{
          let tr=Array.from(ev.results).map(r=>r[0].transcript).join(' ');
          let active=document.activeElement;
          if(active && (active.type==='email' || (active.id||'').toLowerCase().includes('email'))){
            let fixed=tr.toLowerCase().replace(/\s+at\s+/g,'@').replace(/\s+dot\s+/g,'.').replace(/\s+/g,'');
            if(fixed.includes('@')){ active.value=fixed; active.dispatchEvent(new Event('input',{bubbles:true})); }
          }
        }catch(e){}
        return cb.apply(this, arguments);
      });
      return origAdd(type,cb);
    }; return inst;
  }
  Wrapped.prototype=Orig.prototype;
  window.SpeechRecognition=Wrapped; window.webkitSpeechRecognition=Wrapped;
})();

// SCANNING - HANDLE 500 as IRRELEVANT DOCUMENT
function showStatus(el, msg, color){
  if(!el){ el=document.createElement('div'); el.id='scan-status'; document.body.appendChild(el); }
  el.innerText=msg; el.style.display='block'; el.style.color=color; el.style.marginTop='10px'; el.style.fontWeight='bold';
}
window.handleSupplierReceiptUpload=async function(e){
  let file=e.target.files[0]; if(!file) return;
  let s=document.getElementById('scan-status'); if(!s){ s=document.createElement('div'); s.id='scan-status'; e.target.parentElement.appendChild(s); }
  showStatus(s,'⏳ Scanning receipt...','#f59e0b');
  try{
    let fd=new FormData(); fd.append('receipt',file);
    let res=await fetch('https://retail-daily-ledger-ai.onrender.com/upload',{method:'POST',body:fd});
    let txt=await res.text(); let r={}; try{r=JSON.parse(txt);}catch{}
    if(!res.ok){
      if(txt.includes('Failed to process') || txt.includes('Gemini')){
        showStatus(s,'⚠️ Irrelevant document - Please upload Supplier Receipt or Z-Report only','#f59e0b');
      } else {
        showStatus(s,'❌ Server error: '+res.status+' - '+txt.slice(0,120),'#ef4444');
      }
      return;
    }
    (r.Items||[]).forEach(it=> addInv(it.name||'Product', Number(it.quantity||1), Number(it.unit_price||0)));
    showStatus(s,'✅ Added '+(r.Items||[]).length+' items to inventory','#10b981');
    checkAIAdvisor();
  }catch(err){ showStatus(s,'❌ Network error: '+err.message+' - Render may be sleeping, try again in 30s','#ef4444'); }
};
window.handleZReportUpload=async function(e){
  let file=e.target.files[0]; if(!file) return;
  let s=document.getElementById('z-scan-status')||document.getElementById('scan-status');
  if(!s){ s=document.createElement('div'); s.id='z-scan-status'; e.target.parentElement.appendChild(s); }
  showStatus(s,'⏳ Scanning Z-Report...','#f59e0b');
  try{
    let fd=new FormData(); fd.append('receipt',file);
    let res=await fetch('https://retail-daily-ledger-ai.onrender.com/upload',{method:'POST',body:fd});
    let txt=await res.text(); let r={}; try{r=JSON.parse(txt);}catch{}
    if(!res.ok){
      if(txt.includes('Failed to process') || txt.includes('Gemini')){
        showStatus(s,'⚠️ Irrelevant document - Not a Z-Report/Sales Slip','#f59e0b');
      } else {
        showStatus(s,'❌ Server error: '+res.status+' '+txt.slice(0,120),'#ef4444');
      }
      return;
    }
    let total=Number(r.Total||0); if(!total && r.Items) total=r.Items.reduce((a,b)=>a+Number(b.total||0),0);
    let cogs=0,rev=0; (r.Items||[]).forEach(it=>{ let d=deductFIFO(it.name||'Product', Number(it.quantity||1)); cogs+=d.cogs; rev+=Number(it.total||0); });
    if(rev===0) rev=total;
    // PROFIT AUTO CALCULATED HERE
    if(rev>0){ window.salesLog.push({date:new Date().toLocaleDateString(),revenue:rev,cogs:cogs,profit:rev-cogs,items:r.Items||[]}); saveAll(); }
    showStatus(s,`✅ PROFIT AUTO: Revenue ZMW ${rev.toFixed(2)} - Cost ${cogs.toFixed(2)} = Profit ${ (rev-cogs).toFixed(2)}`,'#10b981');
    checkAIAdvisor();
  }catch(err){ showStatus(s,'❌ Network error: '+err.message,'#ef4444'); }
};

// AI ADVISOR - LOW STOCK + SELL THIS
window.checkAIAdvisor = function(){
  let low = window.inventoryQueue.filter(b=>b.qty_remaining>0 && b.qty_remaining<=5);
  let over = window.inventoryQueue.filter(b=>b.qty_remaining>50);
  let advisor = document.getElementById('ai-advisor');
  if(!advisor){
    advisor=document.createElement('div'); advisor.id='ai-advisor';
    advisor.style.cssText='margin:15px 0;padding:12px;border-radius:10px;background:#1f2937;border:1px solid #374151;color:white;';
    let target=document.getElementById('scan-status')||document.querySelector('main')||document.body;
    target.parentElement.insertBefore(advisor, target.nextSibling);
  }
  let html='<b>🤖 AI Advisor:</b><br>';
  if(low.length>0){ html+=`⚠️ Low on stock: ${low.map(b=>`${b.item} (${b.qty_remaining} left)`).join(', ')} - Restock soon!<br>`; }
  if(over.length>0){ html+=`📦 Overstock: ${over.map(b=>`${b.item} (${b.qty_remaining})`).join(', ')} - Make sure you sell this!<br>`; }
  let profit = window.salesLog.reduce((a,b)=>a+(b.profit||0),0);
  let rev = window.salesLog.reduce((a,b)=>a+(b.revenue||0),0);
  html+=`💰 Total Profit so far: ZMW ${profit.toFixed(2)} (from ${window.salesLog.length} Z-Reports, Revenue ZMW ${rev.toFixed(2)})`;
  if(low.length==0 && over.length==0) html+='✅ Stock levels good';
  advisor.innerHTML=html;
};
setTimeout(()=>{ checkAIAdvisor(); }, 3000);
