
console.log('RESTORED ALL v10 - Complete working build');
if(!window.inventoryQueue) window.inventoryQueue=JSON.parse(localStorage.getItem('inventoryQueue')||'[]');
if(!window.salesLog) window.salesLog=JSON.parse(localStorage.getItem('salesLog')||'[]');
function saveAll(){ localStorage.setItem('inventoryQueue', JSON.stringify(window.inventoryQueue)); localStorage.setItem('salesLog', JSON.stringify(window.salesLog)); }
function addInv(n,q,p){ window.inventoryQueue.push({id:Date.now()+Math.random(),date:new Date().toLocaleDateString(),item:n.trim(),vendor:'Supplier',qty_supplied:q,qty_remaining:q,unit:localStorage.getItem('last_unit')||'pcs',unit_price:p||0,expiry:new Date(Date.now()+90*86400000).toISOString().split('T')[0],sales_count:0}); saveAll(); }
function deductFIFO(n,q){ q=Number(q)||0; let rem=q,ded=0,cogs=0; for(let b of window.inventoryQueue){ if(rem<=0) break; if(b.qty_remaining>0 && b.item.toLowerCase()===n.toLowerCase()){ let take=Math.min(b.qty_remaining,rem); b.qty_remaining-=take; rem-=take; ded+=take; cogs+=take*Number(b.unit_price||0); } } if(rem>0){ for(let b of window.inventoryQueue){ if(rem<=0) break; if(b.qty_remaining>0 && (b.item.toLowerCase().includes(n.toLowerCase())||n.toLowerCase().includes(b.item.toLowerCase()))){ let take=Math.min(b.qty_remaining,rem); b.qty_remaining-=take; rem-=take; ded+=take; cogs+=take*Number(b.unit_price||0); } } } saveAll(); return {deducted:ded,cogs}; }

// 1. ANTI-STUCK - unstick login in 3 seconds
setInterval(()=>{
  document.querySelectorAll('button').forEach(btn=>{
    let t=(btn.innerText||'').trim();
    if(t.includes('Connecting to Secure Cloud') || t.includes('Initializing Guest Ledger')){
      btn.disabled=false; btn.style.opacity='1'; btn.style.pointerEvents='auto'; btn.style.cursor='pointer';
      if(!btn.dataset.stuck) btn.dataset.stuck=Date.now();
      if(Date.now()-Number(btn.dataset.stuck)>3000){
        btn.innerText = t.includes('Connecting') ? 'Sign In →' : 'Continue as Guest';
        delete btn.dataset.stuck;
      }
    }
  });
}, 800);

// 2. REAL EXIT GUEST + REAL SIGNOUT - NOT FAKE
function realGoLogin(){
  try{ localStorage.removeItem('guestMode'); localStorage.removeItem('currentUser'); localStorage.removeItem('currentUserEmail'); localStorage.removeItem('isGuest'); localStorage.removeItem('retail_user_session'); sessionStorage.clear(); }catch(e){}
  try{ if(window.firebase?.auth) firebase.auth().signOut(); }catch(e){}
  window.location.href='/';
}
window.exitGuestMode = function(){ if(confirm('Exit Guest Mode?')) realGoLogin(); };
document.addEventListener('click', function(e){
  let b=e.target.closest('button'); if(!b) return;
  let txt=(b.innerText||'').toLowerCase().trim();
  if((txt==='sign out' || txt.includes('sign out') || txt.includes('logout') || txt.includes('exit guest')) && !txt.includes('continue as guest') && !txt.includes('sign in')){
    e.preventDefault(); e.stopImmediatePropagation();
    if(confirm(txt.includes('guest')?'Exit Guest Mode?':'Sign out?')) realGoLogin();
  }
}, true);

// 3. UNIT RIGHT AFTER QUANTITY
function placeUnit(){
  document.querySelectorAll('input').forEach(inp=>{
    let id=(inp.id||'').toLowerCase(); let ph=(inp.placeholder||'').toLowerCase();
    if(!(id.includes('qty')||id.includes('quant')||ph.includes('qty')||ph.includes('quantity'))) return;
    if(inp.nextElementSibling && inp.nextElementSibling.classList.contains('unit-restore')) return;
    let sel=document.createElement('select'); sel.className='unit-restore';
    sel.style.cssText='margin-left:6px;padding:6px 10px;border:1px solid #6b7280;border-radius:8px;background:#111827;color:white;min-width:75px;display:inline-block;';
    ['pcs','kg','g','ltr','ml','box','pack','dozen'].forEach(u=>{ let o=document.createElement('option'); o.value=u; o.textContent=u; sel.appendChild(o); });
    let saved=localStorage.getItem('last_unit'); if(saved) sel.value=saved;
    sel.onchange=()=>localStorage.setItem('last_unit', sel.value);
    inp.insertAdjacentElement('afterend', sel);
  });
}
setInterval(placeUnit, 2000); placeUnit();

// 4. @ FIX - voice "at" -> @ and "dot" -> .
(function(){
  const SR=window.SpeechRecognition||window.webkitSpeechRecognition; if(!SR) return;
  const Orig=SR;
  function Wrapped(){ let i=new Orig(); let origAdd=i.addEventListener.bind(i);
    i.addEventListener=function(t,cb){
      if(t==='result'){ return origAdd(t, function(ev){
        try{
          let tr=Array.from(ev.results).map(r=>r[0].transcript).join(' ');
          let a=document.activeElement;
          if(a && a.tagName==='INPUT' && (a.type==='email' || (a.id||'').toLowerCase().includes('email'))){
            let fixed=tr.toLowerCase().replace(/\s+at\s+/g,'@').replace(/\s+dot\s+/g,'.').replace(/\s*@\s*/g,'@').replace(/\s*\.\s*/g,'.').replace(/\s+/g,'');
            if(fixed.includes('@')){ a.value=fixed; a.dispatchEvent(new Event('input',{bubbles:true})); }
          }
        }catch(e){}
        return cb.apply(this, arguments);
      }); }
      return origAdd(t,cb);
    };
    return i;
  }
  Wrapped.prototype=Orig.prototype;
  window.SpeechRecognition=Wrapped; window.webkitSpeechRecognition=Wrapped;
})();

// 5. RECEIPT + Z-REPORT SCANNING - with real error message
window.handleSupplierReceiptUpload=async function(e){
  let file=e.target.files[0]; if(!file) return;
  let s=document.getElementById('scan-status'); if(!s){ s=document.createElement('div'); s.id='scan-status'; e.target.parentElement.appendChild(s); }
  s.innerText='⏳ Scanning...'; s.style.display='block'; s.style.color='#f59e0b';
  try{
    let fd=new FormData(); fd.append('receipt',file);
    let res=await fetch('https://retail-daily-ledger-ai.onrender.com/upload',{method:'POST',body:fd});
    if(!res.ok){ let txt=await res.text(); s.innerText='❌ Server error: '+res.status+' '+txt.substring(0,100); s.style.color='#ef4444'; return; }
    let r=await res.json(); (r.Items||[]).forEach(it=> addInv(it.name||'Product', Number(it.quantity||1), Number(it.unit_price||0)));
    s.innerText='✅ Added '+(r.Items||[]).length+' items'; s.style.color='#10b981';
  }catch(err){ s.innerText='❌ Network/Server down: '+err.message; s.style.color='#ef4444'; }
};
window.handleZReportUpload=async function(e){
  let file=e.target.files[0]; if(!file) return;
  let s=document.getElementById('z-scan-status')||document.getElementById('scan-status');
  if(!s){ s=document.createElement('div'); s.id='z-scan-status'; e.target.parentElement.appendChild(s); }
  s.innerText='⏳ Scanning Z-Report...'; s.style.color='#f59e0b';
  try{
    let fd=new FormData(); fd.append('receipt',file);
    let res=await fetch('https://retail-daily-ledger-ai.onrender.com/upload',{method:'POST',body:fd});
    if(!res.ok){ let txt=await res.text(); s.innerText='❌ Server error: '+res.status+' '+txt.substring(0,100); s.style.color='#ef4444'; return; }
    let r=await res.json(); let total=Number(r.Total||0); if(!total && r.Items) total=r.Items.reduce((a,b)=>a+Number(b.total||0),0);
    let cogs=0,rev=0; (r.Items||[]).forEach(it=>{ let d=deductFIFO(it.name||'Product', Number(it.quantity||1)); cogs+=d.cogs; rev+=Number(it.total||0); });
    if(rev===0) rev=total; if(rev>0) window.salesLog.push({revenue:rev,cogs,profit:rev-cogs}); saveAll();
    s.innerText=`✅ Rev ${rev.toFixed(2)} - Cost ${cogs.toFixed(2)} = Profit ${(rev-cogs).toFixed(2)}`; s.style.color='#10b981';
  }catch(err){ s.innerText='❌ Network/Server down: '+err.message; s.style.color='#ef4444'; }
};
